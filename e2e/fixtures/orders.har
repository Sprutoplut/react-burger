            "size": 2165,
            "mimeType": "text/javascript",
            "compression": 0,
            "text": "import { API_URL } from \"/src/utils/constants.ts\";\nimport { createApi, fetchBaseQuery } from \"/node_modules/.vite/deps/@reduxjs_toolkit_query_react.js?v=fd7320ef\";\nexport const ordersfeedApi = createApi({\n  reducerPath: \"ordersfeedApi\",\n  baseQuery: fetchBaseQuery({ baseUrl: API_URL }),\n  endpoints: (builder) => ({\n    getOrder: builder.query({\n      query: (orderId) => `/orders/${orderId}`,\n      transformResponse: (response) => {\n        return response.success ? response.order : {};\n      }\n    })\n  })\n});\nexport const { useGetOrderQuery } = ordersfeedApi;\n\n//# sourceMappingURL=data:application/json;base64,"
